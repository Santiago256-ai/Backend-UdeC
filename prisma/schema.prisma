generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Egresado {
  id                Int            @id @default(autoincrement())
  nombres           String
  apellidos         String
  correo            String         @unique
  password          String?
  celular           String?        
  facultad          String?        
  programa          String?
  resetToken        String?        @unique
  resetTokenExpiry  DateTime?
  firebaseUid       String?        @unique
  mensajesRecibidos Mensaje[]      @relation("ReceivedMessages")
  mensajesEnviados  Mensaje[]      @relation("SentMessages")
  notificaciones    Notificacion[]
  cv                PerfilCV?
  postulaciones     Postulacion[]
  estado    String   @default("ACTIVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PerfilCV {
  id          Int           @id @default(autoincrement())
  egresadoId  Int           @unique
  celular     String?
  facultad    String?
  programa    String?
  direccion   String?
  descripcion String?
  habilidades Json?
  aptitudes   Aptitud[]
  educacion   Educacion[]
  experiencia Experiencia[]
  idiomas     Idioma[]
  egresado    Egresado      @relation(fields: [egresadoId], references: [id], onDelete: Cascade)
  referencias Referencia[]
}

model Educacion {
  id          Int      @id @default(autoincrement())
  titulo      String
  institucion String
  periodo     String
  fechaInicio String?  // NUEVO
  fechaFin    String?  // NUEVO
  actualmente Boolean? @default(false) // NUEVO
  perfilId    Int
  perfil      PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Experiencia {
  id          Int      @id @default(autoincrement())
  cargo       String
  empresa     String
  periodo     String
  fechaInicio String?  // NUEVO
  fechaFin    String?  // NUEVO
  actualmente Boolean? @default(false) // NUEVO
  perfilId    Int
  perfil      PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Aptitud {
  id         Int      @id @default(autoincrement())
  aptitud    String
  perfilCVId Int
  perfilCV   PerfilCV @relation(fields: [perfilCVId], references: [id], onDelete: Cascade)
}

model Idioma {
  id         Int      @id @default(autoincrement())
  idioma     String
  nivel      Int
  perfilCVId Int
  perfilCV   PerfilCV @relation(fields: [perfilCVId], references: [id], onDelete: Cascade)
}

model Referencia {
  id       Int      @id @default(autoincrement())
  nombre   String
  cargo    String
  celular  String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Empresa {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  nombre               String
  phones               String
  contactName          String
  
  // --- NUEVOS CAMPOS PARA EL PERFIL ---
  descripcion          String?   // Para la sección "Sobre Nosotros"
  beneficios           String?   // Para "Cultura y Beneficios"
  sitioWeb             String?   // Para "Sitio Web Oficial"
  linkedin             String?   // Para "Perfil de LinkedIn"
  // ------------------------------------

  nit                  String?   @unique
  modalidad            String?
  address              String
  city                 String
  department           String
  companyType          String
  economicSector       String[]
  foundationYear       Int
  employees            String
  annualRevenue        String
  totalAssets          String?
  equity               String?
  distributionChannels String[]
  mainClients          String
  emailAuthorization   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  mensajesEnviados     Mensaje[] @relation("EmpresaSentMessages")
  vacantes             Vacante[]
  notificaciones       Notificacion[]
  estado               String     @default("ACTIVO")
  updatedAt            DateTime   @default(now()) @updatedAt
}

model Vacante {
  id                Int           @id @default(autoincrement())
  titulo            String
  descripcion       String
  ubicacion         String
  tipo              String // Este es el Tipo de Contrato (Fijo, Indefinido, etc.)
  jornada           String // NUEVO: Completo, Medio tiempo, etc.
  modalidad         String // Presencial, Remoto, Híbrido
  tipoSalario       String // NUEVO: Básico, Integral, A convenir
  salario           String? // El monto numérico (opcional)
  horario           String // NUEVO: Ej: Lunes a Viernes 8am - 5pm
  fechaCreacion     DateTime      @default(now())
  fechaCierre       DateTime?
  limitePostulantes Int?
  estado            String        @default("ABIERTA")
  empresaId         Int
  mensajes          Mensaje[]
  postulaciones     Postulacion[]
  empresa           Empresa       @relation(fields: [empresaId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt
}

model Postulacion {
  id         Int      @id @default(autoincrement())
  telefono   String?
  estado     String   @default("PENDIENTE")
  anclado    Boolean  @default(false)
  chatActivo Boolean  @default(true)
  fecha      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt 
  calificacionAdmin  Int?     @default(0)   
  comentarioAdmin    String?
  vacanteId  Int
  egresadoId Int
  notificaciones Notificacion[]
  egresado   Egresado @relation(fields: [egresadoId], references: [id], onDelete: Cascade)
  vacante    Vacante  @relation(fields: [vacanteId], references: [id])

  @@unique([vacanteId, egresadoId])
}

model Mensaje {
  id          Int      @id @default(autoincrement())
  contenido   String
  fechaEnvio  DateTime @default(now())
  read        Boolean  @default(false)

  // Indica quién envía: 'EMPRESA' o 'USUARIO' (Egresado)
  senderType String

  // 1. EL FILTRO DE PRIVACIDAD
  vacanteId Int
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  // 2. REMITENTES
  senderEmpresaId Int?
  senderEmpresa   Empresa? @relation("EmpresaSentMessages", fields: [senderEmpresaId], references: [id])

  // Cambiamos esta relación para que si se borra el Egresado, se borre el mensaje enviado
  senderEgresadoId Int?
  senderEgresado   Egresado? @relation("SentMessages", fields: [senderEgresadoId], references: [id], onDelete: Cascade)

  // 3. RECEPTOR (Egresado)
  // Cambiamos esta relación para que si se borra el Egresado (receptor), se borre el historial
  receiverId Int
  receiver   Egresado @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  // 4. OTROS
  notificacion Notificacion?
}

model Notificacion {
  id           Int          @id @default(autoincrement())
  tipo         String       // 'POSTULACION' o 'MENSAJE'
  contenido    String
  fecha        DateTime     @default(now())
  vista        Boolean      @default(false)
  referenciaId Int?
  
  mensajeId    Int?         @unique
  mensaje      Mensaje?     @relation(fields: [mensajeId], references: [id])
  
  postulacionId Int?        
  postulacion   Postulacion? @relation(fields: [postulacionId], references: [id])

  // --- CAMBIOS PARA SOPORTAR EMPRESAS ---
  
  // Hacemos el egresadoId opcional (?)
  egresadoId   Int?        
  egresado     Egresado?    @relation(fields: [egresadoId], references: [id], onDelete: Cascade)

  // Añadimos el empresaId opcional (?)
  empresaId    Int?
  empresa      Empresa?     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}
