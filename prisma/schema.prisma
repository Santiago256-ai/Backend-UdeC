generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Egresado {
  id                Int            @id @default(autoincrement())
  nombres           String
  apellidos         String
  correo            String         @unique
  password          String?
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  firebaseUid       String?        @unique
  mensajesRecibidos Mensaje[]      @relation("ReceivedMessages")
  mensajesEnviados  Mensaje[]      @relation("SentMessages")
  notificaciones    Notificacion[]
  cv                PerfilCV?
  postulaciones     Postulacion[]
}

model PerfilCV {
  id          Int           @id @default(autoincrement())
  egresadoId  Int           @unique
  celular     String?
  facultad    String?
  programa    String?
  direccion   String?
  descripcion String?
  habilidades String?
  aptitudes   Aptitud[]
  educacion   Educacion[]
  experiencia Experiencia[]
  idiomas     Idioma[]
  egresado    Egresado      @relation(fields: [egresadoId], references: [id])
  referencias Referencia[]
}

model Educacion {
  id          Int      @id @default(autoincrement())
  titulo      String
  institucion String
  periodo     String
  perfilId    Int
  perfil      PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Experiencia {
  id       Int      @id @default(autoincrement())
  cargo    String
  empresa  String
  periodo  String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Aptitud {
  id         Int      @id @default(autoincrement())
  aptitud    String
  perfilCVId Int
  perfilCV   PerfilCV @relation(fields: [perfilCVId], references: [id], onDelete: Cascade)
}

model Idioma {
  id         Int      @id @default(autoincrement())
  idioma     String
  nivel      Int
  perfilCVId Int
  perfilCV   PerfilCV @relation(fields: [perfilCVId], references: [id], onDelete: Cascade)
}

model Referencia {
  id       Int      @id @default(autoincrement())
  nombre   String
  cargo    String
  celular  String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Empresa {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  nombre               String
  phones               String
  contactName          String
  nit                  String?   @unique
  address              String
  city                 String
  department           String
  companyType          String
  economicSector       String[]
  foundationYear       Int
  employees            String
  annualRevenue        String
  totalAssets          String?
  equity               String?
  distributionChannels String[]
  mainClients          String
  emailAuthorization   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  mensajesEnviados     Mensaje[] @relation("EmpresaSentMessages")
  vacantes             Vacante[]
}

model Vacante {
  id                Int           @id @default(autoincrement())
  titulo            String
  descripcion       String
  ubicacion         String
  tipo              String
  modalidad         String
  salario           String?
  fechaCreacion     DateTime      @default(now())
  fechaCierre       DateTime?
  limitePostulantes Int?
  estado            String        @default("ABIERTA")
  empresaId         Int
  mensajes          Mensaje[]
  postulaciones     Postulacion[]
  empresa           Empresa       @relation(fields: [empresaId], references: [id])
}

model Postulacion {
  id         Int      @id @default(autoincrement())
  telefono   String?
  estado     String   @default("PENDIENTE")
  chatActivo Boolean  @default(true)
  fecha      DateTime @default(now())
  vacanteId  Int
  egresadoId Int
  egresado   Egresado @relation(fields: [egresadoId], references: [id])
  vacante    Vacante  @relation(fields: [vacanteId], references: [id])

  @@unique([vacanteId, egresadoId])
}

model Mensaje {
  id               Int           @id @default(autoincrement())
  contenido        String
  fechaEnvio       DateTime      @default(now())
  read             Boolean       @default(false)
  senderType       String
  vacanteId        Int?
  senderEmpresaId  Int?
  senderEgresadoId Int?
  receiverId       Int
  receiver         Egresado      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  senderEgresado   Egresado?     @relation("SentMessages", fields: [senderEgresadoId], references: [id])
  senderEmpresa    Empresa?      @relation("EmpresaSentMessages", fields: [senderEmpresaId], references: [id])
  vacante          Vacante?      @relation(fields: [vacanteId], references: [id])
  notificacion     Notificacion?
}

model Notificacion {
  id           Int      @id @default(autoincrement())
  tipo         String
  contenido    String
  fecha        DateTime @default(now())
  vista        Boolean  @default(false)
  referenciaId Int?
  mensajeId    Int?     @unique
  egresadoId   Int
  egresado     Egresado @relation(fields: [egresadoId], references: [id])
  mensaje      Mensaje? @relation(fields: [mensajeId], references: [id])
}
