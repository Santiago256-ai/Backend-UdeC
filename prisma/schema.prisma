generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// MODELOS DE USUARIO Y PERFIL CV
// =========================================================

model Usuario {
  id            Int           @id @default(autoincrement())
  nombres       String
  apellidos     String
  usuario       String        @unique
  correo        String        @unique
  password      String?
  firebaseUid   String?       @unique 
  rol           String        @default("estudiante")
  
  cv            PerfilCV?
  postulaciones Postulacion[]
  mensajesEnviados  Mensaje[]   @relation("SentMessages")
  mensajesRecibidos Mensaje[]   @relation("ReceivedMessages")
  notificaciones    Notificacion[]
}

model PerfilCV {
  id          Int    @id @default(autoincrement())
  usuarioId   Int    @unique
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  telefono    String?
  email       String?
  direccion   String?

  descripcion String?
  habilidades String?

  educacion   Educacion[]
  experiencia Experiencia[]
  idiomas     Idioma[]
  referencias Referencia[]
}

model Educacion {
  id          Int      @id @default(autoincrement())
  titulo      String
  institucion String
  periodo     String
  perfilId    Int
  perfil      PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Experiencia {
  id       Int      @id @default(autoincrement())
  cargo    String
  empresa  String
  periodo  String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Idioma {
  id       Int      @id @default(autoincrement())
  idioma   String
  nivel    String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

model Referencia {
  id       Int      @id @default(autoincrement())
  nombre   String
  cargo    String
  celular  String
  perfilId Int
  perfil   PerfilCV @relation(fields: [perfilId], references: [id], onDelete: Cascade)
}

// =========================================================
// MODELOS DE EMPRESA Y VACANTES
// =========================================================

model Empresa {
  id Int @id @default(autoincrement())
  email              String @unique
  password           String
  nombre             String
  phones             String
  contactName        String
  nit                String? @unique
  address            String
  city               String
  department         String
  companyType        String
  economicSector     String[] 
  foundationYear     Int
  employees          String
  annualRevenue      String
  totalAssets        String?
  equity             String?
  distributionChannels String[]
  mainClients        String
  emailAuthorization Boolean @default(false)
  createdAt          DateTime @default(now())

  vacantes           Vacante[]
  mensajesEnviados   Mensaje[] @relation("EmpresaSentMessages")
}

model Vacante {
  id            Int      @id @default(autoincrement())
  titulo        String
  descripcion   String
  ubicacion     String
  tipo          String
  modalidad     String
  salario       String?
  fechaCreacion DateTime @default(now())
  fechaCierre   DateTime?
  limitePostulantes Int?
  estado        String   @default("ABIERTA")

  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  postulaciones Postulacion[]
  mensajes      Mensaje[]
}

model Postulacion {
  id         Int      @id @default(autoincrement())
  telefono   String?
  estado     String   @default("PENDIENTE")
  chatActivo Boolean  @default(true)
  fecha      DateTime @default(now())

  vacanteId  Int
  usuarioId  Int
  vacante    Vacante  @relation(fields: [vacanteId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([vacanteId, usuarioId]) 
}

// =========================================================
// CHAT Y NOTIFICACIONES
// =========================================================

model Mensaje {
  id         Int      @id @default(autoincrement())
  contenido  String
  fechaEnvio DateTime @default(now())
  read       Boolean  @default(false)
  senderType String

  vacanteId       Int?
  vacante         Vacante? @relation(fields: [vacanteId], references: [id])
  senderEmpresaId Int?
  senderEmpresa   Empresa? @relation("EmpresaSentMessages", fields: [senderEmpresaId], references: [id])
  senderUsuarioId Int?
  senderUsuario   Usuario? @relation("SentMessages", fields: [senderUsuarioId], references: [id])
  receiverId      Int
  receiver        Usuario  @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  notificacion    Notificacion?
}

model Notificacion {
  id           Int      @id @default(autoincrement())
  tipo         String
  contenido    String
  fecha        DateTime @default(now())
  vista        Boolean  @default(false)
  referenciaId Int?
  mensajeId    Int?     @unique
  mensaje      Mensaje? @relation(fields: [mensajeId], references: [id])
  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
}